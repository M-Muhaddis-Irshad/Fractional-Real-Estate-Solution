PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/flux_fractional
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google OAuth ("Continue with Google") ---
# Get these from Google Cloud Console (see prompt.md notes). Until they're set,
# the Google button redirects to an error and email/password auth is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI you register in Google Cloud Console,
# e.g. http://localhost:4000/api/auth/google/callback for dev and
# https://<your-api-host>/api/auth/google/callback for production.
GOOGLE_CALLBACK_URL=

# Cloudinary (optional — property images / avatars). Get these from cloudinary.com console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset emails (Resend). Get the key from https://resend.com/api-keys.
# Without RESEND_API_KEY the server logs reset links to the console instead of
# sending mail, so the flow still works in development.
RESEND_API_KEY=
# Sender address — on the free plan you must use onboarding@resend.dev until
# your own domain is verified.
MAIL_FROM=Flux <onboarding@resend.dev>
# Public origin the reset link points to (the deployed frontend URL).
FRONTEND_URL=http://localhost:5173
# Note: reset links are one-time tokens (random bytes, hashed in the DB),
# so no extra secret is required beyond RESEND_API_KEY.

# --- Crypto payments (Coinbase Commerce) ---
# Get these from https://commerce.coinbase.com/dashboard/settings/api-keys
# (API key + webhook shared secret). Until COINBASE_COMMERCE_API_KEY is set,
# the app runs in DEMO mode: payments show a simulated wallet address and
# auto-confirm after ~20s so the full flow stays testable. No real funds move
# in demo mode.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
# Configure the webhook endpoint in the Coinbase dashboard to point at:
#   POST https://<your-api-host>/api/payments/crypto/webhook
# (event type: all charge:* events)

# --- Realtime bridge (standalone socket server on Render) ---
# URL of the deployed socket-server (e.g. https://<service>.onrender.com).
# When set, socket events are forwarded to it over HTTP (POST /emit) instead of
# being emitted in-process — required because Vercel is serverless and can't
# host a persistent Socket.IO connection.
SOCKET_SERVER_URL=https://<socket-service>.onrender.com
# Shared secret — the socket-server checks this in the x-socket-secret header.
SOCKET_SERVER_SECRET=change-me-to-a-long-random-string

# Seed super admin
SUPER_ADMIN_EMAIL=muhaddisirshad58@gmail.com
SUPER_ADMIN_PASSWORD=fluxx@@
