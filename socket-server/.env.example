# Port the socket server listens on (Render sets this automatically).
PORT=4001

# Same MongoDB the Vercel REST API uses — required for socket auth (we look up
# the connecting user to enforce "active" status). Get this from the Vercel
# backend project's MONGODB_URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# MUST match the Vercel backend's JWT_SECRET, otherwise socket auth rejects every client.
JWT_SECRET=change-me-to-a-long-random-string

# Public origin(s) of the deployed frontend — comma-separated is NOT supported;
# set the main one (e.g. https://your-frontend.vercel.app). Local dev origins are
# always allowed for convenience.
FRONTEND_URL=https://your-frontend.vercel.app

# Shared secret between the Vercel REST API and this socket server. The REST API
# sends this in the x-socket-secret header on POST /emit.
SOCKET_SERVER_SECRET=change-me-to-another-long-random-string
